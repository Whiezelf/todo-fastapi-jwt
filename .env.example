# Copia questo file in .env e compila i valori. NON committare .env.
# Genera una chiave: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Opzionale in locale (default: SQLite in ./todos.db). Esempio Postgres:
# DATABASE_URL=postgresql://utente:password@host:5432/nomedb
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
